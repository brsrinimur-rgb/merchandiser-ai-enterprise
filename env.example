# Microsoft Entra ID application credentials
D365_TENANT_ID=00000000-0000-0000-0000-000000000000
D365_CLIENT_ID=00000000-0000-0000-0000-000000000000
D365_CLIENT_SECRET=replace-with-secret-from-secure-vault

# Example: https://your-environment.operations.dynamics.com
D365_RESOURCE_URL=https://your-environment.operations.dynamics.com
D365_COMPANY=USMF
D365_TIMEOUT_SECONDS=60
D365_VERIFY_SSL=true

# Entity names are configurable because D365 implementations differ.
D365_ENTITY_STORES=RetailStores
D365_ENTITY_SUPPLIERS=VendorsV2
D365_ENTITY_ITEMS=ReleasedProductsV2
D365_ENTITY_SALES=RetailTransactions
D365_ENTITY_STOCK=InventOnHand
D365_ENTITY_PURCHASE_ORDERS=PurchaseOrderLinesV2
D365_ENTITY_PO_HEADERS=PurchaseOrderHeadersV2

# Keep false until D365 UAT and security approval
D365_ENABLE_WRITEBACK=false
D365_ENTITY_TRANSFER_ORDERS=TransferOrderHeaders
